generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client"
  previewFeatures = ["fullTextIndex", "fullTextSearch"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model user {
  id                      String             @id @default(cuid())
  email                   String             @unique
  password                String?
  name                    String?
  role                    String             @default("USER")
  emailVerified           DateTime?
  image                   String?            @db.LongText
  phone                   String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @default(now()) @updatedAt
  avatarUrl               String?            @db.VarChar(512)
  lastCheckIn             DateTime?
  points                  Int                @default(0)
  twoFactorEnabled        Boolean            @default(false)
  notificationPreferences String?            @db.LongText
  activeSessions          activesession[]
  addresses               address[]
  cart                    cart?
  loginHistory            loginhistory[]
  notifications           notification[]
  orders                  order[]
  pointTransactions       pointtransaction[]
  productQAs              productqa[]
  refundRequests          refundrequest[]
  reviews                 review[]
  twoFactorTokens         twofactortoken[]
  userVouchers            uservoucher[]
  wishlists               wishlist[]
}

model verificationtoken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model loginhistory {
  id           String   @id @default(cuid())
  userId       String
  ipAddress    String?  @db.VarChar(64)
  userAgent    String?  @db.Text
  country      String?  @db.VarChar(64)
  city         String?  @db.VarChar(64)
  isSuspicious Boolean  @default(false)
  createdAt    DateTime @default(now())
  user         user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model activesession {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique @db.VarChar(512)
  ipAddress    String?  @db.VarChar(64)
  deviceInfo   String?  @db.VarChar(256)
  browserName  String?  @db.VarChar(64)
  lastSeen     DateTime @default(now())
  createdAt    DateTime @default(now())
  user         user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model twofactortoken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @db.VarChar(10)
  expires   DateTime
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model address {
  id        String   @id @default(cuid())
  userId    String
  fullName  String
  phone     String
  address   String
  city      String
  state     String?
  zipCode   String
  country   String   @default("USA")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logo      String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  products  product[]
}

model product {
  id                String                 @id @default(cuid())
  name              String
  slug              String?                @unique
  description       String                 @db.Text
  price             Float
  salePrice         Float?
  saleStartAt       DateTime?
  saleEndAt         DateTime?
  isOnSale          Boolean                @default(false)
  badgeText         String?
  image             String?
  // Legacy category name (will be migrated to Category relation)
  category          String
  categoryId        String?
  inventory         Int                    @default(0)
  featured          Boolean                @default(false)
  // Controls whether product should be visible on storefront
  isVisible         Boolean                @default(true)
  brandId           String?
  originalPrice     Float?
  // Legacy tags CSV (will be migrated to Tag relation)
  tags              String?
  ratingAvg         Float                  @default(0)
  ratingCount       Int                    @default(0)
  soldCount         Int                    @default(0)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @default(now()) @updatedAt
  code              String?                @unique
  weight            String?
  deletedAt         DateTime?
  isDeleted         Boolean                @default(false)
  cartItems         cartitem[]
  flashSaleProducts flashsaleproduct[]
  orderItems        orderitem[]
  brand             brand?                 @relation(fields: [brandId], references: [id])
  categoryRel       category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  productImages     productimage[]
  productMedia      productmedia[]
  productQAs        productqa[]
  shipping          productshipping?
  specifications    productspecification[]
  productVariants   productvariant[]
  productViews      productview[]
  reviews           review[]
  productTags       producttag[]
  wishlists         wishlist[]

  @@index([brandId])
  @@index([category])
  @@index([categoryId])
  @@index([isOnSale])
  @@index([featured])
  @@index([isVisible])
  @@index([soldCount])
  @@index([ratingAvg])
  @@fulltext([name, description])
}

model category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?    @db.Text
  imageUrl    String?    @db.VarChar(512)
  parentId    String?
  position    Int        @default(0)
  isVisible   Boolean    @default(true)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent      category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children    category[] @relation("CategoryParent")
  products    product[]

  @@index([parentId])
  @@index([position])
  @@index([isVisible])
  @@index([isActive])
}

model tag {
  id        String      @id @default(cuid())
  name      String
  slug      String      @unique
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  products  producttag[]

  @@index([isActive])
}

model producttag {
  productId String
  tagId     String
  createdAt DateTime @default(now())

  product   product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model productimage {
  id        String   @id @default(cuid())
  productId String
  imageUrl  String
  altText   String?
  order     Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  product   product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isPrimary])
}

model productmedia {
  id        String   @id @default(cuid())
  productId String
  type      String
  url       String
  order     Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  product   product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([type])
}

model productvariant {
  id              String      @id @default(cuid())
  productId       String
  weight          String?
  flavor          String?
  priceAdjustment Float       @default(0)
  stock           Int         @default(0)
  sku             String?     @unique
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now()) @updatedAt
  cartItems       cartitem[]
  orderItems      orderitem[]
  product         product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isActive])
}

model productview {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  createdAt DateTime @default(now())
  product   product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@index([createdAt])
}

model cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  guestToken String?    @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @default(now()) @updatedAt
  user       user?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      cartitem[]
}

model cartitem {
  id        String          @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt
  cart      cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   productvariant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
  @@index([variantId], map: "cartitem_variantId_fkey")
}

model order {
  id              String          @id @default(cuid())
  userId          String
  status          String          @default("PENDING")
  subtotal        Float           @default(0)
  shippingFee     Float           @default(0)
  discount        Float           @default(0)
  total           Float
  couponId        String?
  couponCode      String?
  shippingAddress String?
  shippingCity    String?
  shippingZipCode String?
  shippingPhone   String?
  shippingMethod  String?         @default("standard")
  carrier         String?
  trackingCode    String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  paymentMethod   String?
  paymentStatus   String          @default("UNPAID")
  paymentIntentId String?
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt
  pointsDiscount  Float?
  pointsUsed      Int?
  user            user            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events          orderevent[]
  orderItems      orderitem[]
  refundRequests  refundrequest[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model orderitem {
  id           String          @id @default(cuid())
  orderId      String
  productId    String
  variantId    String?
  quantity     Int
  price        Float
  nameSnapshot String?
  skuSnapshot  String?
  createdAt    DateTime        @default(now())
  order        order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      product         @relation(fields: [productId], references: [id])
  variant      productvariant? @relation(fields: [variantId], references: [id])
  reviews      review?

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([createdAt])
}

model orderevent {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  note      String?  @db.Text
  createdAt DateTime @default(now())
  order     order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model refundrequest {
  id           String    @id @default(cuid())
  orderId      String
  userId       String
  orderItemId  String?
  reason       String    @db.Text
  amount       Float
  status       String    @default("PENDING")
  adminNote    String?   @db.Text
  refundMethod String?
  bankAccount  String?
  bankName     String?
  processedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  order        order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user         user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

model review {
  id          String        @id @default(cuid())
  productId   String
  userId      String
  orderItemId String?       @unique
  rating      Int
  comment     String?       @db.Text
  status      String        @default("PENDING")
  adminReply  String?       @db.Text
  repliedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  orderItem   orderitem?    @relation(fields: [orderItemId], references: [id])
  product     product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        user          @relation(fields: [userId], references: [id], onDelete: Cascade)
  media       reviewmedia[]

  @@index([productId])
  @@index([userId])
  @@index([status, rating])
  @@index([productId, status])
}

model reviewmedia {
  id        String   @id @default(cuid())
  reviewId  String
  type      String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  review    review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model Coupon {
  id            String        @id @default(cuid())
  code          String        @unique
  discountType  String
  discountValue Float
  minOrderValue Float?        @default(0)
  maxDiscount   Float?
  startDate     DateTime      @default(now())
  endDate       DateTime
  isActive      Boolean       @default(true)
  usageLimit    Int?
  usedCount     Int           @default(0)
  category      String        @default("all")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  userVouchers  uservoucher[]

  @@map("coupon")
}

model uservoucher {
  id        String    @id @default(cuid())
  userId    String
  couponId  String
  status    String    @default("CLAIMED")
  claimedAt DateTime  @default(now())
  usedAt    DateTime?
  coupon    Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, couponId])
  @@index([userId])
  @@index([couponId])
}

model notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String   @db.Text
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model banner {
  id        String    @id @default(cuid())
  imageUrl  String
  title     String
  subtitle  String?
  ctaText   String?
  ctaLink   String?
  startAt   DateTime?
  endAt     DateTime?
  priority  Int       @default(0)
  isActive  Boolean   @default(true)
  placement String    @default("home")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([placement, isActive, priority])
}

model contactmessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model systemsetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([key])
}

model post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String?  @db.Text
  content     String   @db.LongText
  image       String?
  authorName  String?  @default("LIKEFOOD")
  category    String?  @default("Tin tức")
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
  @@index([publishedAt])
}

model wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model productqa {
  id        String   @id @default(cuid())
  productId String
  userId    String
  question  String   @db.Text
  answer    String?  @db.Text
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  product   product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@index([createdAt])
}

model productspecification {
  id        String   @id @default(cuid())
  productId String
  key       String
  value     String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([order])
}

model productshipping {
  id            String   @id @default(cuid())
  productId     String   @unique
  weight        Float?
  length        Float?
  width         Float?
  height        Float?
  freeShipMin   Float?
  shippingFee   Float?
  estimatedDays Int      @default(3)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model flashsalecampaign {
  id        String             @id @default(cuid())
  name      String
  startAt   DateTime
  endAt     DateTime
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  products  flashsaleproduct[]

  @@index([startAt, endAt])
  @@index([isActive])
}

model flashsaleproduct {
  id             String            @id @default(cuid())
  campaignId     String
  productId      String
  flashSalePrice Float
  stockLimit     Int?
  soldCount      Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  campaign       flashsalecampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product        product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@index([campaignId])
  @@index([productId])
}

model pointtransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  type        String
  description String?
  orderId     String?
  createdAt   DateTime @default(now())
  user        user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model newslettersubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())

  @@index([subscribedAt])
}

/// Individual email queue entries for transactional emails
model emailqueue {
  id          String    @id @default(cuid())
  userId      String?
  email       String
  subject     String
  templateKey String
  data        String?   @db.LongText
  status      String    @default("PENDING")
  priority    String    @default("NORMAL")
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
}

model AiKnowledge {
  id        String   @id
  category  String
  question  String?  @db.Text
  answer    String   @db.LongText
  keywords  String?
  language  String   @default("vi")
  priority  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([category], map: "aiKnowledge_category_idx")
  @@index([isActive], map: "aiKnowledge_isActive_idx")
  @@index([language], map: "aiKnowledge_language_idx")
  @@map("aiknowledge")
}

model BehaviorEvent {
  id         String   @id
  userId     String?
  sessionId  String
  eventType  String
  eventData  String?  @db.LongText
  url        String?  @db.VarChar(500)
  referrer   String?  @db.VarChar(500)
  deviceType String   @default("desktop")
  createdAt  DateTime @default(now())

  @@index([createdAt], map: "behaviorEvent_createdAt_idx")
  @@index([eventType], map: "behaviorEvent_eventType_idx")
  @@index([sessionId], map: "behaviorEvent_sessionId_idx")
  @@index([userId], map: "behaviorEvent_userId_idx")
  @@map("behaviorevent")
}

model ConversationHistory {
  id         String   @id
  userId     String?
  sessionId  String
  role       String
  message    String   @db.LongText
  intent     String?
  confidence Float?
  feedback   String?
  createdAt  DateTime @default(now())

  @@index([createdAt], map: "conversationHistory_createdAt_idx")
  @@index([sessionId], map: "conversationHistory_sessionId_idx")
  @@index([userId], map: "conversationHistory_userId_idx")
  @@map("conversationhistory")
}

model DynamicPage {
  id              String   @id
  title           String
  slug            String   @unique(map: "dynamicPage_slug_key")
  content         String   @db.LongText
  excerpt         String?  @db.Text
  metaTitle       String?
  metaDescription String?
  image           String?
  template        String   @default("default")
  type            String
  isPublished     Boolean  @default(true)
  isDefault       Boolean  @default(false)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@index([isPublished], map: "dynamicPage_isPublished_idx")
  @@index([slug], map: "dynamicPage_slug_idx")
  @@index([type], map: "dynamicPage_type_idx")
  @@map("dynamicpage")
}

model emailcampaign {
  id            String    @id
  name          String
  triggerType   String
  subject       String
  body          String    @db.LongText
  language      String    @default("vi")
  segmentFilter String?   @db.LongText
  scheduledAt   DateTime?
  sentCount     Int       @default(0)
  openCount     Int       @default(0)
  clickCount    Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime

  @@index([isActive], map: "emailCampaign_isActive_idx")
  @@index([triggerType], map: "emailCampaign_triggerType_idx")
}

model HomepageSection {
  id          String    @id
  key         String    @unique(map: "homepageSection_key_key")
  title       String?
  subtitle    String?
  description String?   @db.Text
  config      String?   @db.LongText
  type        String
  isActive    Boolean   @default(true)
  position    Int       @default(0)
  limit       Int       @default(10)
  startAt     DateTime?
  endAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime

  @@index([isActive], map: "homepageSection_isActive_idx")
  @@index([position], map: "homepageSection_position_idx")
  @@map("homepagesection")
}

model MenuItem {
  id         String    @id
  name       String
  slug       String    @unique(map: "menuItem_slug_key")
  type       String
  url        String?
  categoryId String?
  productId  String?
  pageId     String?
  icon       String?
  parentId   String?
  position   Int       @default(0)
  isVisible  Boolean   @default(true)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime

  parent     MenuItem?  @relation("MenuItemParent", fields: [parentId], references: [id], onDelete: SetNull, map: "menuItem_parentId_fkey")
  children   MenuItem[] @relation("MenuItemParent")

  @@index([isVisible], map: "menuItem_isVisible_idx")
  @@index([parentId], map: "menuItem_parentId_idx")
  @@index([position], map: "menuItem_position_idx")
  @@map("menuitem")
}

model PushNotification {
  id          String    @id
  userId      String
  type        String
  title       String
  body        String
  data        String?   @db.LongText
  sentAt      DateTime  @default(now())
  readAt      DateTime?
  deliveredAt DateTime?
  clickedAt   DateTime?

  @@index([sentAt], map: "pushNotification_sentAt_idx")
  @@index([type], map: "pushNotification_type_idx")
  @@index([userId], map: "pushNotification_userId_idx")
  @@map("pushnotification")
}

model SiteConfig {
  id          String   @id
  key         String   @unique(map: "siteConfig_key_key")
  value       String   @db.Text
  type        String   @default("text")
  category    String   @default("general")
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([category], map: "siteConfig_category_idx")
  @@index([key], map: "siteConfig_key_idx")
  @@map("siteconfig")
}

model UserSegment {
  id           String    @id
  userId       String
  segment      String
  score        Float     @default(1)
  calculatedAt DateTime  @default(now())
  expiresAt    DateTime?

  @@unique([userId, segment], map: "userSegment_userId_segment_key")
  @@index([segment], map: "userSegment_segment_idx")
  @@map("usersegment")
}
